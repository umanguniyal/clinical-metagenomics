def illumina_ml_targets():
    if PROFILE != "bioinformatician":
        return []
    return [os.path.join(RESULTS_DIR, "illumina", s, "ml_results", "predictions.csv") for s in SAMPLES_ILLUMINA if not s.endswith("_control")]

def nanopore_ml_targets():
    if PROFILE != "bioinformatician":
        return []
    return [os.path.join(RESULTS_DIR, "nanopore", s, "ml_results", "predictions.csv") for s in SAMPLES_NANOPORE if not s.endswith("_control")]

def cohort_ml_targets():
    if PROFILE != "bioinformatician":
        return []
    return [os.path.join(RESULTS_DIR, "cohort_ml_results", "cohort_pca_landscape.png")]

rule write_detected_dbs:
    input:
        MANIFEST
    output:
        DB_JSON
    run:
        os.makedirs(RESULTS_DIR, exist_ok=True)
        data = {
            "project_root": PROJECT_ROOT,
            "manifest": MANIFEST,
            "kraken_db": KRAKEN_DB,
            "centrifuge_prefix": CENTRIFUGE_DB,
            "host_mmi": HOST_MMI,
            "host_bt2_prefix": HOST_BT2,
            "checkm2_db": CHECKM2_DB,
            "resfinder_kma_prefix": RESFINDER_DB,
            "samples_detected": {"illumina": SAMPLES_ILLUMINA, "nanopore": SAMPLES_NANOPORE},
            "profile": PROFILE,
            "platform": PLATFORM
        }
        with open(output[0], "w") as f:
            json.dump(data, f, indent=2)

rule all:
    input:
        DB_JSON,
        illumina_centrifuge_targets() if PLATFORM == "illumina" else [],
        nanopore_centrifuge_targets() if PLATFORM == "nanopore" else [],
        illumina_krona_targets() if PLATFORM == "illumina" else [],
        nanopore_krona_targets() if PLATFORM == "nanopore" else [],
        illumina_reports() if PLATFORM == "illumina" else [],
        illumina_reports_txt() if PLATFORM == "illumina" else [],
        nanopore_reports() if PLATFORM == "nanopore" else [],
        nanopore_reports_txt() if PLATFORM == "nanopore" else [],
        clinician_extra_amr_targets() if PROFILE == "clinician" else [],
        illumina_plasmid_targets() if PLATFORM == "illumina" else [],
        nanopore_plasmid_targets() if PLATFORM == "nanopore" else [],
        illumina_ml_targets() if PLATFORM == "illumina" else [],
        nanopore_ml_targets() if PLATFORM == "nanopore" else [],
        cohort_ml_targets()

