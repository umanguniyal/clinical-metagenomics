onerror:
    import glob
    err_log = os.path.join(RESULTS_DIR, "pipeline_errors.log")
    if os.path.exists(err_log):
        with open(err_log) as f:
            errors = f.read().strip()
        if errors:
            print("\n" + "="*60)
            print("PIPELINE COMPLETED WITH ERRORS (some samples failed)")
            print("="*60)
            print(errors)
            print("="*60 + "\n")

onsuccess:
    err_log = os.path.join(RESULTS_DIR, "pipeline_errors.log")
    if os.path.exists(err_log):
        with open(err_log) as f:
            errors = f.read().strip()
        if errors:
            print("\n" + "="*60)
            print("PIPELINE COMPLETED — but some samples had warnings:")
            print("="*60)
            print(errors)
            print("="*60 + "\n")
    else:
        print("\nPIPELINE COMPLETED SUCCESSFULLY — no errors.\n")
